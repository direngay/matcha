---
import { ClientRouter } from 'astro:transitions'
import Nav from '../components/nav.astro'
import { fade } from 'astro:transitions'
interface Props {
    title?: string
}
const {title = "Matcha yum!"} =  Astro.props
---

<html lang="en" transition:animate={fade({ duration: "0.2s" })}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <link rel="icon" href="https://i.ibb.co/HL5Lprqz/New-Piskel-1-png-13.png">
        <ClientRouter/>
    </head>
    <body>
        <div class="container">
            <header>
                <Nav />
            </header>
            <slot/>
        </div>
    </body>
</html>
<style>
    @import "tailwindcss";
    *{
        margin: 0;
        padding:0;
        box-sizing: border-box;
        image-rendering: pixelated;
    }
    body{
        background: #e6ffd0;
    }
    .container{
        width: 550px;
        background: #e6ffd0;
        position: absolute;
        right:0;
        margin: 10px;
    }
    header{
        width: 100%;
        height: 240px;
        background: url("https://i.ibb.co/B20jhT3m/New-Project-1.png");
        position: relative;
    }
    ::-webkit-scrollbar{
        width: 9px;
        background-color: #e6ffd0;
    }
    ::-webkit-scrollbar-thumb{
        background-color: var(--color-lime-200);
        border-radius: 20px;
    }
</style>